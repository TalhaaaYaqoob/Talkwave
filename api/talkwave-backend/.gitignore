# ============================================================================
# TalkWave Backend - Git Ignore
# ============================================================================

# Environment & Secrets (NEVER commit these!)
.env
.env.*
!.env.template
!env.template

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
run/
*.pid

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Backup files (don't commit these)
*.backup
*.bak
*.orig

# Database
*.db
*.sqlite3

# Native libraries (platform-specific, should be built in Docker)
native/rnnoise/*.so*

# Local configuration
alembic/versions/*.pyc

# Temporary files
tmp/
temp/
*.tmp

# Infrastructure (keep separate)
infrastructure/
nginx/
prd/
