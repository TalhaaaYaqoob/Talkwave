# ============================================================================
# TalkWave Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# SECURITY: Never commit .env files to version control!
# ============================================================================

# ============================================================================
# Required Configuration
# ============================================================================

# Database URL - PostgreSQL connection string
# Railway Postgres (recommended): Railway auto-injects this when you link a Postgres service.
#   Format: postgresql+asyncpg://postgres:[password]@[host].railway.internal:5432/railway
# Supabase: postgresql+asyncpg://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Force SSL for database connections (auto-detected for Supabase URLs, set to true for external DBs)
DB_USE_SSL=false

# Redis URL for caching and rate limiting
# Format: redis://:[password]@[host]:[port]
REDIS_URL=redis://:change-me@localhost:6379

# ============================================================================
# Supabase Configuration (used for Storage only — database is on Railway)
# ============================================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
# SUPABASE_DB_PASSWORD is only needed if DATABASE_URL is not set and you fall back to Supabase DB
SUPABASE_DB_PASSWORD=

# ============================================================================
# Authentication Configuration
# ============================================================================

# Deployment mode: "cloud" for managed service.
# NOTE: the legacy "oss" mode trusted unverified tokens and has been removed.
DEPLOYMENT_MODE=cloud

# Auth provider: "clerk" or "stack". Requests are cryptographically/server-side
# verified against the configured provider. There is no local bypass.
AUTH_PROVIDER=clerk

# Clerk Backend API credentials (Dashboard → API Keys).
# CLERK_SECRET_KEY must be the Secret key (sk_live_... / sk_test_...), NOT a
# restricted machine key — restricted keys often 403 on organization endpoints.
CLERK_SECRET_KEY=
# Backend API host. Keep this as api.clerk.com even if your Frontend API /
# JWT issuer is a custom domain like https://clerk.example.com.
CLERK_API_URL=https://api.clerk.com
# Publishable key (also used server-side to derive JWKS context)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Superuser bootstrap (optional). Any authenticated user whose email or provider
# id (Clerk user id, e.g. user_2abc...) matches these comma-separated lists is
# automatically promoted to superuser on their next login. Use this to grant
# yourself admin access without direct database access.
# Example:
#   SUPERUSER_EMAILS=me@example.com,admin@example.com
#   SUPERUSER_PROVIDER_IDS=user_2abc123,user_2def456
SUPERUSER_EMAILS=
SUPERUSER_PROVIDER_IDS=

# ============================================================================
# CORS Configuration (Optional)
# ============================================================================

# Comma-separated list of allowed origins for CORS
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Frontend URL (automatically added to CORS origins)
UI_APP_URL=http://localhost:3010

# Backend API endpoint
BACKEND_API_ENDPOINT=http://localhost:8000

# ============================================================================
# Storage Configuration
# ============================================================================

# Storage backend: "supabase", "s3", or "minio"
STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=voice-audio

# AWS S3 (if using S3 storage)
ENABLE_AWS_S3=false
S3_BUCKET=
S3_REGION=us-east-1

# ============================================================================
# Integration Providers (Optional)
# ============================================================================

# Composio API key for OAuth integrations
# Get your API key from https://app.composio.dev
COMPOSIO_API_KEY=

# Composio custom auth config IDs for white-labeling (optional).
# When set, OAuth consent screens show YOUR app name instead of "Composio".
# Create custom auth configs at: https://platform.composio.dev → Authentication management
# Each var follows the pattern: COMPOSIO_AUTH_CONFIG_{APP}=ac_xxxx
# COMPOSIO_AUTH_CONFIG_GMAIL=
# COMPOSIO_AUTH_CONFIG_GOOGLESHEETS=
# COMPOSIO_AUTH_CONFIG_GOOGLEDRIVE=
# COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=
# COMPOSIO_AUTH_CONFIG_SLACK=
# COMPOSIO_AUTH_CONFIG_GITHUB=
# COMPOSIO_AUTH_CONFIG_LINEAR=
# COMPOSIO_AUTH_CONFIG_HUBSPOT=
# COMPOSIO_AUTH_CONFIG_NOTION=

# ============================================================================
# Monitoring & Telemetry (Optional)
# ============================================================================

# Sentry DSN for error tracking
SENTRY_DSN=

# Sentry performance sampling rates (0.0 to 1.0)
# traces: % of requests tracked for performance (default: 0.2 = 20%)
# profiles: % of traced requests profiled for CPU (default: 0.1 = 10%)
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# PostHog for product analytics and user tracking
# Get your API key from https://posthog.com → Project Settings → Project API Key
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Enable telemetry (only used in OSS mode)
ENABLE_TELEMETRY=false

# ============================================================================
# LLM Provider (pick one — Cerebras is preferred for lowest latency)
# ============================================================================

# Cerebras: ultra-fast inference (~2000 tok/s). Takes priority over OpenAI.
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# OpenAI: fallback if CEREBRAS_API_KEY is not set
# OPENAI_API_KEY=

# ============================================================================
# Realtime Web Search (agent "search the internet" tool)
# ============================================================================
# Provider-agnostic search used by the agent's search_web tool when "Web
# search" is enabled on an agent node. Works with ANY LLM (Cerebras included).
# Set at least one key — providers are tried in this order:
# Tavily (https://tavily.com — recommended, returns direct answers for voice)
TAVILY_API_KEY=
# Serper (https://serper.dev — Google results)
SERPER_API_KEY=
# Brave Search API (https://brave.com/search/api)
BRAVE_SEARCH_API_KEY=

# ============================================================================
# Speech-to-Text (STT) — Deepgram Nova-3 / Flux (recommended)
# ============================================================================
# Get your key from https://console.deepgram.com — Nova-3 supports 30+ languages
# including Arabic, Chinese, Hindi, etc. and is the default Talkwave STT.
DEEPGRAM_API_KEY=

# ============================================================================
# Text-to-Speech (TTS) — Gemini primary, Cartesia fallback
# ============================================================================
# Default TTS strategy:
#   • Gemini TTS → primary TTS for ALL supported languages, including Arabic
#     and Chinese. It is the only provider that renders a specific regional
#     accent on request (e.g. Qatari, Saudi or Egyptian Arabic), which is what
#     the accent picker in the workflow editor drives.
#   • Cartesia Sonic-3.5 → fallback, used when Gemini credentials are missing
#     or the Gemini API is unreachable. 42 languages, ~90ms TTFA.
#
# ElevenLabs has been retired and its key is no longer read.

# --- Gemini TTS (primary) ---------------------------------------------------
# Gemini TTS goes through the Google Cloud Text-to-Speech API, which uses a
# service account rather than an API key. Create one with the
# "Cloud Text-to-Speech API User" role, then supply it in ONE of three ways:
#
#   1. Inline JSON (best for Railway / container platforms) — paste the whole
#      service account JSON on a single line:
# GOOGLE_TTS_CREDENTIALS={"type":"service_account","project_id":"..."}
#
#   2. Path to the service account JSON file:
# GOOGLE_TTS_CREDENTIALS_PATH=/secrets/google-tts.json
#
#   3. Application default credentials, picked up automatically:
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-tts.json
#
# Model override. Defaults to gemini-3.1-flash-tts-preview, which has the
# strongest accent steering. Pin gemini-2.5-flash-tts if you need a GA model.
# Options: gemini-3.1-flash-tts-preview, gemini-2.5-flash-tts,
#          gemini-2.5-flash-lite-preview-tts, gemini-2.5-pro-tts
# GEMINI_TTS_MODEL=gemini-2.5-flash-tts

# Gemini API key — used by Realtime Voice mode (Gemini Live), NOT by Gemini TTS.
GOOGLE_API_KEY=

# --- Cartesia (fallback) ----------------------------------------------------
# Cartesia API key (https://play.cartesia.ai → API Keys). Strongly recommended
# so calls survive a Gemini outage.
CARTESIA_API_KEY=

# ============================================================================
# Qdrant Cloud Vector Database
# ============================================================================

# Qdrant Cloud URL (e.g. https://xxxx.us-east4-0.gcp.cloud.qdrant.io:6333)
QDRANT_URL=
# Qdrant Cloud API key
QDRANT_API_KEY=

# ============================================================================
# Persistent Voice-Agent Memory (self-hosted Mem0)
# ============================================================================
# Gives voice agents long-term memory ACROSS calls: the agent recalls relevant
# facts from a caller's previous conversations before responding, and retains
# new facts after each turn. Enabled per workflow via
# `workflow_configurations.memory_enabled` (opt-in).
#
# Backend is fully self-hosted — no data leaves your infra:
#   • Vector store  -> your Qdrant (reuses QDRANT_URL / QDRANT_API_KEY above)
#   • Embedder      -> OpenAI (needs OPENAI_API_KEY)
#   • Extraction LLM-> OpenAI (needs OPENAI_API_KEY)
# Requires `pip install mem0ai` (already in requirements.txt).
#
# Optional overrides (sensible defaults shown):
# MEMORY_LLM_MODEL=gpt-4o-mini
# MEMORY_EMBED_MODEL=text-embedding-3-small
# MEMORY_EMBED_DIMS=1536
# MEMORY_QDRANT_COLLECTION=voice_agent_memory

# ============================================================================
# Advanced Configuration (Optional)
# ============================================================================

# Environment: local, development, staging, production
ENVIRONMENT=local

# Enable smart turn detection for voice AI
ENABLE_SMART_TURN=true

# Enable request tracing
ENABLE_TRACING=false

# Enable RNNoise for noise suppression
ENABLE_RNNOISE=false

# Serialize log output as JSON
SERIALIZE_LOG_OUTPUT=false

# Enable ARI/Stasis for Asterisk integration
ENABLE_ARI_STASIS=false

# ============================================================================
# LiveKit Cloud Configuration (recommended for 100+ concurrent calls)
# ============================================================================
# Sign up at https://cloud.livekit.io, create a project, and copy credentials.
# When LIVEKIT_URL is set, browser calls use LiveKit Cloud for media transport
# instead of self-hosted aiortc. Telephony (Twilio/Vonage/Vobiz) is unaffected.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ============================================================================
# WebRTC ICE / TURN Configuration (only used when LiveKit is NOT configured)
# ============================================================================
# Browser calls (/workflow/<id>/run/<id>) establish a WebRTC peer connection to
# the backend. Callers behind symmetric NAT, corporate firewalls, or VPNs cannot
# traverse NAT with STUN alone — a TURN relay is required. Without it the
# signalling WebSocket still connects but no audio bytes flow in either
# direction: logs show `Failed to write audio frame` and transcripts contain
# only the bot's own greeting.
#
# Option 1 — Twilio Network Traversal Service (easiest, production-grade).
# Create a Twilio account; the REST Account SID / Auth Token can be reused from
# the ones you already use for telephony, OR you can dedicate a separate
# subaccount for ICE tokens (recommended so you can rotate independently).
TWILIO_ICE_ACCOUNT_SID=
TWILIO_ICE_AUTH_TOKEN=
#
# Option 2 — Static TURN (self-hosted coturn, Metered, Xirsys, Cloudflare).
# Comma-separate multiple URLs so browsers can try UDP first, then TCP/TLS 443
# as a fallback through restrictive firewalls.
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
#
# Optional — override the STUN server(s). Defaults to Google's public STUN.
STUN_URLS=

# ============================================================================
# Email (SendGrid) — used by the agent's send-email tool
# ============================================================================

# SendGrid API key (starts with SG.)
SENDGRID_API_KEY=

# ============================================================================
# Meeting Agent (Recall.ai) — AI that joins Zoom/Meet/Teams meetings
# ============================================================================
# Sign up at https://www.recall.ai, create an API key in the dashboard.
# When set, the Meeting Agent feature is enabled — users can send an AI
# participant to join meetings, listen, and respond when addressed.
RECALL_API_KEY=
# Region for Recall.ai API: us-west-2, us-east-1, eu-central-1, ap-northeast-1
RECALL_API_REGION=ap-northeast-1

# Meeting Agent — session & concurrency limits
MEETING_MAX_SESSIONS_PER_USER=5
MEETING_MAX_SESSIONS_GLOBAL=100
MEETING_MAX_CONCURRENT_RESPONSES=10
MEETING_BOT_POLL_INTERVAL_SECONDS=15
MEETING_SESSION_TTL_HOURS=24

# ============================================================================
# Scaling & Concurrency Configuration
# ============================================================================
# Tune these for your expected call volume. The values below are sized for
# ~500-1000 concurrent calls with LiveKit Cloud handling media transport.
#
# IMPORTANT: Each Uvicorn worker gets its own copy of the DB pool, so the
# effective max DB connections = UVICORN_WORKERS × (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# Make sure your Postgres max_connections can handle this.
#
# ┌───────────────────────┬──────────┬──────────────┬────────────────────────┐
# │ Setting               │ Dev      │ Production   │ High-scale (1000+)     │
# ├───────────────────────┼──────────┼──────────────┼────────────────────────┤
# │ UVICORN_WORKERS       │ 2        │ 4            │ 4-8                    │
# │ DB_POOL_SIZE          │ 5        │ 20           │ 30                     │
# │ DB_MAX_OVERFLOW       │ 7        │ 20           │ 30                     │
# │ DB_POOL_TIMEOUT       │ 10       │ 30           │ 30                     │
# │ ARQ_MAX_JOBS          │ 50       │ 200          │ 500                    │
# │ CONCURRENT_CALL_LIMIT │ 20       │ 100          │ 500                    │
# └───────────────────────┴──────────┴──────────────┴────────────────────────┘

# Number of Uvicorn worker processes
UVICORN_WORKERS=4

# Database connection pool size per worker
DB_POOL_SIZE=20

# Extra connections above pool_size when under load (total max per worker = pool_size + max_overflow)
DB_MAX_OVERFLOW=20

# Seconds to wait for a DB connection before raising an error
DB_POOL_TIMEOUT=30

# ARQ background worker max concurrent jobs (cost calc, transcripts, integrations)
ARQ_MAX_JOBS=200

# Campaign batch size — calls dispatched per batch
CAMPAIGN_BATCH_SIZE=100

# Default concurrent call limit per organization
DEFAULT_CONCURRENT_CALL_LIMIT=100
