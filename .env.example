# ============================================================================
# TalkWave — Docker Compose environment
# ============================================================================
# Copy to `.env` in the repository root:  cp .env.example .env
# Provider API keys (LLM / STT / TTS / telephony) go in
# api/talkwave-backend/.env — see api/talkwave-backend/env.template.
# ============================================================================

# --- Infrastructure (required) ----------------------------------------------
# Generate strong values, e.g.:  openssl rand -hex 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
REDIS_PASSWORD=
MINIO_ROOT_USER=talkwave
MINIO_ROOT_PASSWORD=

# --- Authentication (required) ----------------------------------------------
# TalkWave verifies every request with Clerk. A free Clerk development
# instance is enough for self-hosting: https://dashboard.clerk.com
# The secret key goes in api/talkwave-backend/.env as CLERK_SECRET_KEY.
NEXT_PUBLIC_AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- App ---------------------------------------------------------------------
UI_APP_URL=http://localhost:3010

# Image registry prefix for `docker compose build` / `push`.
# REGISTRY=ghcr.io/your-org

# --- Optional telemetry (off by default) --------------------------------------
ENABLE_TELEMETRY=false
# API_SENTRY_DSN=
# UI_SENTRY_DSN=
# POSTHOG_KEY=

# --- Optional: remote deployments (docker compose --profile remote) -----------
# TURN_HOST=
# TURN_USERNAME=
# TURN_PASSWORD=
# TURN_REALM=
